# Baza de date PostgreSQL folosită de Payload CMS.
# Local: postgresql://postgres:parola@localhost:5432/weblex
# xCloud ("Create Database In Server") sau extern (Neon/Railway) — vezi README.
DATABASE_URI=postgresql://user:password@host:5432/database

# Cheie secretă pentru Payload (criptare sesiuni admin). Generează una lungă și aleatoare,
# de exemplu cu: openssl rand -base64 32
PAYLOAD_SECRET=schimba-asta-cu-ceva-lung-si-aleator

# URL-ul public al site-ului (folosit în linkurile din emailuri, ex. linkul de semnare contract).
NEXT_PUBLIC_SERVER_URL=https://weblexdesign.ro

# Trimitere email (Resend — resend.com, cont gratuit). Fără cheie, emailurile doar se
# loghează în consolă și site-ul funcționează normal, dar clienții nu primesc notificări reale.
RESEND_API_KEY=
EMAIL_FROM="Weblex Design <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=contact@weblexdesign.ro

# Generare de conținut cu AI din admin (texte, SEO, imagini) — cheie de pe
# platform.openai.com (cont cu credit adăugat, DALL-E costă separat de ChatGPT).
# Fără cheie, butoanele „Generează cu AI” arată un mesaj clar de eroare, restul
# site-ului funcționează normal.
OPENAI_API_KEY=

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
